# Safe examples for the optional HyDE script; runtime stack variables remain in its compose configuration.
GEMINI_API_KEY=
HYDE_MODEL=

# Explicit origins for approved knowledge stores. Server-side workspace configuration
# determines isolation; client metadata cannot create separate workspaces.
LIGHTRAG_MEDICAL_URL=
LIGHTRAG_CODEBASE_URL=
LIGHTRAG_API_KEY=
# Source groups and limits: config/ingestion.json. No live --execute without cost approval.

# Optional multimodal processor: models and dimensions are required for --execute.
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
# Container defaults and limits: ragAnything/processor.json; optional absolute overrides.
RAGANYTHING_INPUT_ROOT=/app/data
RAGANYTHING_WORKING_DIR=/app/storage
RAGANYTHING_OUTPUT_DIR=/app/output
RAGANYTHING_POLICY_FILE=/app/processor.json
RAGANYTHING_API_BASE=https://generativelanguage.googleapis.com
RAGANYTHING_API_VERSION=v1beta
