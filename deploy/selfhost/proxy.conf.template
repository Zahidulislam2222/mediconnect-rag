worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/null;
events { worker_connections ${PROXY_CONNECTIONS}; }
http {
    access_log off;
    server_tokens off;
    client_max_body_size ${PROXY_MAX_BODY_SIZE};
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    scgi_temp_path /tmp/scgi;
    uwsgi_temp_path /tmp/uwsgi;
    proxy_connect_timeout ${PROXY_CONNECT_TIMEOUT};
    proxy_read_timeout ${PROXY_READ_TIMEOUT};
    proxy_send_timeout ${PROXY_READ_TIMEOUT};
    proxy_next_upstream off;
    proxy_buffering off;
    proxy_set_header Host $host;
    # Docker's embedded DNS address is a fixed container-network protocol value.
    resolver 127.0.0.11 valid=${PROXY_DNS_TTL} ipv6=off;
    resolver_timeout ${PROXY_DNS_TIMEOUT};
    server {
        listen ${PROXY_MEDICAL_PORT};
        set $medical_backend medical:${RAG_CONTAINER_PORT};
        location / { proxy_pass http://$medical_backend; }
    }
    server {
        listen ${PROXY_CODEBASE_PORT};
        set $codebase_backend codebase:${RAG_CONTAINER_PORT};
        location / { proxy_pass http://$codebase_backend; }
    }
}
