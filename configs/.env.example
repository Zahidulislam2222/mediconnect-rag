# MediConnect RAG Stack — Environment Variables
# Copy this to .env and fill in real values

# LLM Configuration (for LightRAG embeddings + generation)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_BINDING=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_BINDING=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# Grafana
GRAFANA_ADMIN_PASSWORD=your-strong-password-here

# Scanning targets (for Checkov, Prowler, Trivy)
DEV_PATH=/path/to/mediconnect-infrastructure-production
TERRAFORM_PROD_PATH=/path/to/mediconnect-infrastructure-production/environments/prod
AWS_CONFIG_DIR=/path/to/.aws
GCP_KEY_PATH=/path/to/gcp-service-account.json
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
